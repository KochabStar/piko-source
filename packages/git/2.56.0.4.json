{
  "schemaVersion": 1,
  "name": "git",
  "version": "2.56.0.4",
  "platforms": {
    "windows-x64": {
      "url": "https://github.com/git-for-windows/git/releases/download/v2.56.0.windows.4/PortableGit-2.56.0.4-64-bit.7z.exe",
      "sha256": "b1f3e52216e2ed6882d1bebfd4d3fdf319bec40d2edbbf9fd26ec4fd3fce7ed1",
      "format": "7z",
      "bin": {
        "sh": "bin/sh.exe",
        "git": "cmd/git.exe",
        "gitk": "cmd/gitk.exe",
        "git-gui": "cmd/git-gui.exe",
        "scalar": "cmd/scalar.exe",
        "git-bash": "git-bash.exe",
        "gpg": "usr/bin/gpg.exe",
        "gpg-agent": "usr/bin/gpg-agent.exe",
        "gpgconf": "usr/bin/gpgconf.exe",
        "gpg-connect-agent": "usr/bin/gpg-connect-agent.exe",
        "pinentry": "usr/bin/pinentry.exe"
      },
      "env": {
        "GIT_INSTALL_ROOT": "{root}"
      },
      "desktop": {
        "shortcuts": [
          {
            "name": "Git - Git Bash",
            "path": "git-bash.exe",
            "args": ["--cd-to-home"]
          },
          {
            "name": "Git - Git CMD",
            "path": "git-cmd.exe",
            "args": ["--cd-to-home"]
          },
          {
            "name": "Git - Git GUI",
            "path": "cmd/git-gui.exe"
          }
        ],
        "environment": {
          "GIT_INSTALL_ROOT": "{root}"
        }
      }
    }
  }
}
